def print_analysis(analysis: dict[str, object]) -> None:
    price_stats = analysis["price_stats"]
    area_iqr = analysis["area_iqr"]
    outliers = analysis["outliers"]
    strongest_variable, strongest_value = analysis["strongest_price_correlation"]

    print("=== WSTĘPNA EKSPLORACJA ===")
    print(f"Shape: {analysis['shape']}")
    print("\nBraki danych:")
    print(analysis["missing_values"])
    print("\nPodejrzane obserwacje:")
    for item in analysis["suspicious_observations"]:
        print(f"- {item}")

    print("\n=== STATYSTYKI OPISOWE ===")
    print(f"Średnia cena: {price_stats['mean']:.2f}")
    print(f"Mediana ceny: {price_stats['median']:.2f}")
    print(f"Odchylenie standardowe ceny: {price_stats['std']:.2f}")
    print(f"Skewness ceny: {price_stats['skewness']:.2f}")
    print(f"Kurtosis ceny: {price_stats['kurtosis']:.2f}")
    print(f"Metraż Q1/Q3/IQR: {area_iqr['q1']:.2f} / {area_iqr['q3']:.2f} / {area_iqr['iqr']:.2f}")
    print(f"Liczba dzielnic: {analysis['unique_district_count']}")

    print("\n=== ZALEŻNOŚCI ===")
    print(f"Najsilniejsza korelacja z ceną: {strongest_variable} ({strongest_value:.2f})")
    print(f"Najwyższa cena za m2: {analysis['highest_price_per_m2_district']}")

    print("\n=== OUTLIERY ===")
    print(f"Cena IQR: {int(outliers['cena_iqr'].sum())}")
    print(f"Cena Z-score: {int(outliers['cena_zscore'].sum())}")
    print(f"Cena Modified Z-score: {int(outliers['cena_modified_zscore'].sum())}")
    print(f"Metraż IQR: {int(outliers['metraz_iqr'].sum())}")
    print(f"Nielogiczne lata budowy: {len(analysis['invalid_year_rows'])}")

    print("\n=== WNIOSKI ===")
    for conclusion in analysis["conclusions"]:
        print(f"- {conclusion}")


def main() -> None:
    df = generate_apartment_data(output_path=RAW_CSV_PATH)
    analysis = analyze_apartments(df)
    cleaned = clean_apartment_data(df)
    chart_paths = save_charts(df, cleaned, analysis)

    cleaned.to_csv(CLEAN_CSV_PATH, index=False)
    save_report(df, cleaned, analysis, chart_paths)
    print_analysis(analysis)
    print(f"\nZapisano dane surowe: {RAW_CSV_PATH.resolve()}")
